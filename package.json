{
  "name": "kring-vlr",
  "version": "1.0.15",
  "description": "Painel pessoal de VODs, lineups e estatísticas para Valorant",
  "main": "electron/main.cjs",
  "author": "Kring",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint . && ruff check analyzer/",
    "lint:js": "eslint .",
    "lint:py": "ruff check analyzer/",
    "format:check": "prettier --check .",
    "migrate:dry-run": "node scripts/migrate-dry-run.cjs",
    "check": "npm test && npm run lint && npm run build && node --check electron/main.cjs electron/preload.cjs electron/migrations/v4.cjs scripts/migrate-dry-run.cjs && python -m py_compile analyzer/analyzer.py",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.7",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.kring.vlrstats",
    "productName": "Kring VLR",
    "publish": {
      "provider": "github",
      "owner": "gabrielphilipus",
      "repo": "kring-vlr",
      "releaseType": "release"
    },
    "asar": true,
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "analyzer",
        "to": "analyzer",
        "filter": [
          "**/*",
          "!dist",
          "!build",
          "!__pycache__"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kring VLR"
    }
  }
}
